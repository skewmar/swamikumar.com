# The public values below are safe to use locally. Keep secrets in Vercel
# Environment Variables or Apple Keychain, never in Git.

PUBLIC_SITE_URL=https://www.swamikumar.com
GITHUB_REPOSITORY=skewmar/swamikumar.com

# Required only for the private /studio editor.
# The GitHub OAuth App callback must be https://www.swamikumar.com/api/studio/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://www.swamikumar.com/api/studio/callback
STUDIO_SESSION_SECRET=
