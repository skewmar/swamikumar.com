---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<div class="paper-grain" aria-hidden="true"></div>

		<section class="panel hero">
			<div class="copy">
				<p class="eyebrow">Swami Kumar</p>
				<h1>I work on the systems that help teams see clearly and move with intent.</h1>
				<p class="lede">
					My work sits between strategy, customer understanding, and the practical work of getting an
					organization aligned around what matters.
				</p>
			</div>
		</section>

		<section class="panel atlan">
			<div class="copy narrow">
				<p class="eyebrow">2021 - 2026</p>
				<h2>Atlan</h2>
				<p>
					At Atlan, I worked across go-to-market strategy, customer and market intelligence, product
					marketing, and the occasional pseudo-PM problem. The goal was simple: make the company a
					faster learning and executing organization.
				</p>
				<p>
					That meant building an intelligence engine around early customers, turning signals into
					clearer decisions, and helping sales, product, and marketing work from the same picture.
				</p>
			</div>
		</section>

		<section class="panel public-systems">
			<div class="copy narrow">
				<p class="eyebrow">2019 - 2021</p>
				<h2>Public systems</h2>
				<p>
					At India’s Ministry of Health, I led an innovation charter at the National Health Authority,
					working on ways to improve access, quality, and affordability across a public health system
					serving more than 500 million people.
				</p>
				<p>
					The work included a market-access program for healthcare innovation and the formation of a
					blended-finance fund to support startups during COVID.
				</p>
			</div>
		</section>

		<section class="panel foundations">
			<div class="copy narrow">
				<p class="eyebrow">Earlier</p>
				<h2>Strategy, growth, and research</h2>
				<p>
					Earlier chapters took me through political and corporate digital strategy, product and growth
					work in real estate, and venture research at Duke. Across them, I learned to enjoy the hard
					part: getting from a noisy set of inputs to a decision someone can actually use.
				</p>
			</div>
		</section>

		<section class="panel closing">
			<div class="copy narrow">
				<p class="eyebrow">Now</p>
				<h2>Still curious about how context changes what is possible.</h2>
				<p>More soon.</p>
			</div>
		</section>
	</main>
</Layout>

<style>
	:root {
		--ink: #222522;
		--muted: rgba(34, 37, 34, 0.63);
		--paper: #f5f2eb;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	main {
		position: relative;
		overflow: hidden;
		background: var(--paper);
		isolation: isolate;
	}

	.panel {
		position: relative;
		display: flex;
		box-sizing: border-box;
		min-height: 88svh;
		align-items: center;
		padding: clamp(2.5rem, 8vw, 8rem) clamp(1.5rem, 12vw, 14rem);
	}

	.panel::before {
		position: absolute;
		z-index: -1;
		inset: 0;
		content: '';
		opacity: 0.88;
	}

	.hero {
		min-height: 100svh;
	}

	.hero::before {
		background:
			radial-gradient(ellipse at 8% 88%, rgba(170, 186, 179, 0.55), transparent 43%),
			radial-gradient(ellipse at 85% 16%, rgba(188, 208, 218, 0.46), transparent 42%),
			linear-gradient(138deg, #f6f2ea 8%, #e9efeb 48%, #e8edf0 100%);
	}

	.atlan::before {
		background:
			radial-gradient(ellipse at 82% 50%, rgba(204, 188, 166, 0.5), transparent 45%),
			linear-gradient(140deg, #f4f1e9 0%, #e4ece9 100%);
	}

	.public-systems::before {
		background:
			radial-gradient(ellipse at 16% 74%, rgba(192, 204, 184, 0.55), transparent 42%),
			linear-gradient(145deg, #eef1e9 6%, #f4eee4 92%);
	}

	.foundations::before {
		background:
			radial-gradient(ellipse at 82% 78%, rgba(205, 174, 155, 0.52), transparent 47%),
			linear-gradient(145deg, #f5f0e9 10%, #e9e9e3 100%);
	}

	.closing::before {
		background:
			radial-gradient(ellipse at 20% 16%, rgba(188, 204, 211, 0.45), transparent 42%),
			linear-gradient(140deg, #edf0ed 0%, #f6f2e9 100%);
	}

	.copy {
		max-width: 52rem;
		animation: appear 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.copy.narrow {
		max-width: 39rem;
	}

	.eyebrow {
		margin: 0 0 0.85rem;
		font-family: var(--sans);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	h1,
	h2,
	p {
		font-family: var(--sans);
		color: var(--ink);
	}

	h1,
	h2 {
		margin: 0;
		font-weight: 700;
		letter-spacing: -0.035em;
		line-height: 1.12;
	}

	h1 {
		max-width: 40rem;
		font-size: clamp(2rem, 4vw, 3.35rem);
	}

	h2 {
		max-width: 31rem;
		font-size: clamp(1.55rem, 2.7vw, 2.2rem);
	}

	p {
		max-width: 37rem;
		margin: 1rem 0 0;
		font-size: 1.0625rem;
		font-weight: 400;
		letter-spacing: -0.012em;
		line-height: 1.47;
		color: var(--muted);
	}

	.lede {
		max-width: 35rem;
		font-size: 1.0625rem;
		line-height: 1.47;
	}

	.paper-grain {
		position: fixed;
		z-index: 2;
		inset: 0;
		opacity: 0.22;
		background-image:
			radial-gradient(rgba(53, 58, 53, 0.14) 0.5px, transparent 0.75px),
			radial-gradient(rgba(255, 255, 255, 0.95) 0.5px, transparent 0.8px),
			repeating-linear-gradient(103deg, transparent 0 11px, rgba(73, 98, 88, 0.035) 12px 13px);
		background-position: 0 0, 4px 5px, 0 0;
		background-size: 7px 7px, 11px 11px, 22px 25px;
		mix-blend-mode: multiply;
		pointer-events: none;
	}

	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(12px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 640px) {
		.panel {
			min-height: 76svh;
			padding: 5rem 1.65rem;
		}

		.hero {
			min-height: 100svh;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.copy {
			animation: none;
		}
	}
</style>
