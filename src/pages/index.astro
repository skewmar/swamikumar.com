---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="note">
		<div class="paper-grain" aria-hidden="true"></div>

		<article>
			<header>
				<p class="site-name">swamikumar.com</p>
				<h1>Swami Kumar</h1>
				<p class="summary">
					Strategy, intelligence, and the work of helping teams make clearer decisions.
				</p>
			</header>

			<section aria-labelledby="experience-heading">
				<div class="section-label">
					<h2 id="experience-heading">Experience</h2>
					<span>Selected</span>
				</div>

				<ul class="experience-list">
					<li>
						<span class="period">2021 - 2026</span>
						<p><strong>Atlan</strong> — GTM strategy, customer intelligence, and product marketing.</p>
					</li>
					<li>
						<span class="period">2019 - 2021</span>
						<p><strong>National Health Authority, India</strong> — healthcare innovation and public systems.</p>
					</li>
					<li>
						<span class="period">Earlier</span>
						<p><strong>Strategy, growth, and research</strong> — political, corporate, product, and venture work.</p>
					</li>
				</ul>
			</section>

			<footer>
				<p>More soon.</p>
			</footer>
		</article>
	</main>
</Layout>

<style>
	:root {
		--ink: #20211f;
		--muted: rgba(32, 33, 31, 0.56);
		--rule: rgba(32, 33, 31, 0.15);
		--paper: #f6f3ed;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	.note {
		position: relative;
		box-sizing: border-box;
		min-height: 100svh;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 92% 0%, rgba(190, 209, 215, 0.36), transparent 34rem),
			radial-gradient(ellipse at 0% 100%, rgba(205, 199, 176, 0.34), transparent 32rem),
			var(--paper);
	}

	article {
		position: relative;
		z-index: 1;
		width: min(100% - 3rem, 52rem);
		margin: 0 auto;
		padding: clamp(2.25rem, 7vh, 5.5rem) 0 2.5rem;
	}

	.site-name,
	.section-label,
	.period,
	footer p {
		font-family: var(--sans);
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	.site-name {
		margin: 0 0 2rem;
	}

	h1,
	h2,
	p {
		font-family: var(--sans);
	}

	h1 {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		letter-spacing: -0.045em;
		line-height: 1.08;
		color: var(--ink);
	}

	.summary {
		max-width: 34rem;
		margin: 0.65rem 0 0;
		font-size: 1.0625rem;
		letter-spacing: -0.013em;
		line-height: 1.45;
		color: var(--muted);
	}

	section {
		margin-top: clamp(3rem, 10vh, 6rem);
		border-top: 1px solid var(--rule);
	}

	.section-label {
		display: flex;
		justify-content: space-between;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--rule);
	}

	h2 {
		margin: 0;
		font: inherit;
	}

	.experience-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.experience-list li {
		display: grid;
		grid-template-columns: 8.75rem minmax(0, 1fr);
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.period {
		padding-top: 0.08rem;
	}

	.experience-list p {
		margin: 0;
		font-size: 1rem;
		letter-spacing: -0.012em;
		line-height: 1.4;
		color: var(--muted);
	}

	strong {
		font-weight: 600;
		color: var(--ink);
	}

	footer {
		margin-top: clamp(3rem, 8vh, 5rem);
	}

	footer p {
		margin: 0;
	}

	.paper-grain {
		position: fixed;
		z-index: 2;
		inset: 0;
		opacity: 0.2;
		background-image:
			radial-gradient(rgba(53, 58, 53, 0.13) 0.5px, transparent 0.75px),
			radial-gradient(rgba(255, 255, 255, 0.95) 0.5px, transparent 0.8px);
		background-position: 0 0, 4px 5px;
		background-size: 7px 7px, 11px 11px;
		mix-blend-mode: multiply;
		pointer-events: none;
	}

	@media (max-width: 600px) {
		article {
			width: min(100% - 2.5rem, 52rem);
		}

		.experience-list li {
			grid-template-columns: 1fr;
			gap: 0.28rem;
		}
	}
</style>
