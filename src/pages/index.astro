---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="desktop">
		<input class="window-state" type="radio" name="window-state" id="note-open" checked />
		<input class="window-state" type="radio" name="window-state" id="note-resting" />
		<input class="window-state" type="radio" name="window-state" id="note-closed" />

		<section class="notes-window" aria-label="Swami Kumar’s note">
			<aside class="sidebar" aria-label="Notes">
				<div class="sidebar-heading">
					<div class="window-controls" aria-label="Window controls">
						<label class="window-dot red" for="note-closed" aria-label="Close note" title="Close note"></label>
						<label class="window-dot yellow minimize" for="note-resting" aria-label="Minimize note" title="Minimize note"></label>
						<label class="window-dot yellow maximize" for="note-open" aria-label="Maximize note" title="Maximize note"></label>
					</div>
					<span aria-hidden="true">•••</span>
				</div>
				<p class="section-label">notes</p>
				<div class="selected-note">
					<p>A creative mind</p>
					<span>in a logical world</span>
				</div>
			</aside>

			<article class="note-page">
				<p class="date">August 2026</p>
				<h1>swami kumar</h1>
				<p class="intro">A creative mind stuck in a logical world.</p>
				<p class="note-copy">Notes on crafting, systems, and in-between spaces.</p>
			</article>
			<span class="resize-handle north-west" aria-hidden="true"></span>
			<span class="resize-handle north-east" aria-hidden="true"></span>
			<span class="resize-handle south-west" aria-hidden="true"></span>
			<span class="resize-handle south-east" aria-hidden="true"></span>
		</section>

		<div class="notes-bay" aria-label="Notes dock">
			<span class="dock-app finder" aria-hidden="true"></span>
			<span class="dock-app launch" aria-hidden="true"></span>
			<label class="dock-app notes-app" for="note-open" aria-label="Open note" title="Open note">
				<span class="notes-icon" aria-hidden="true"></span>
			</label>
			<span class="dock-app photos" aria-hidden="true"></span>
			<span class="dock-app music" aria-hidden="true"></span>
			<span class="dock-separator" aria-hidden="true"></span>
			<span class="dock-app settings" aria-hidden="true"></span>
		</div>

		<p class="wallpaper-credit">
			Photo by <a href="https://unsplash.com/@dreiimos">Lucas Calloch</a> on <a href="https://unsplash.com/photos/red-and-green-trees-beside-river-during-daytime-P-yzuyWFEIk">Unsplash</a>
		</p>
	</main>
</Layout>

<script>
	const noteWindow = document.querySelector('.notes-window');
	const restingState = document.querySelector('#note-resting');
	const openState = document.querySelector('#note-open');
	const resizeHandles = document.querySelectorAll('.resize-handle');

	const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

	resizeHandles.forEach((handle) => {
		handle.addEventListener('pointerdown', (event) => {
			if (!noteWindow || !restingState?.checked) return;

			event.preventDefault();
			const edge = [...handle.classList].find((name) => ['north-west', 'north-east', 'south-west', 'south-east'].includes(name));
			const startingRect = noteWindow.getBoundingClientRect();
			const startX = event.clientX;
			const startY = event.clientY;
			const minWidth = 420;
			const minHeight = 300;

			noteWindow.classList.add('is-resized');
			noteWindow.style.left = `${startingRect.left}px`;
			noteWindow.style.top = `${startingRect.top}px`;
			noteWindow.style.width = `${startingRect.width}px`;
			noteWindow.style.height = `${startingRect.height}px`;

			const resize = (moveEvent) => {
				const shiftX = moveEvent.clientX - startX;
				const shiftY = moveEvent.clientY - startY;
				let width = startingRect.width;
				let height = startingRect.height;
				let left = startingRect.left;
				let top = startingRect.top;

				if (edge?.includes('east')) width = clamp(startingRect.width + shiftX, minWidth, window.innerWidth - startingRect.left);
				if (edge?.includes('south')) height = clamp(startingRect.height + shiftY, minHeight, window.innerHeight - startingRect.top);
				if (edge?.includes('west')) {
					left = clamp(startingRect.left + shiftX, 0, startingRect.right - minWidth);
					width = startingRect.right - left;
				}
				if (edge?.includes('north')) {
					top = clamp(startingRect.top + shiftY, 0, startingRect.bottom - minHeight);
					height = startingRect.bottom - top;
				}

				noteWindow.style.left = `${left}px`;
				noteWindow.style.top = `${top}px`;
				noteWindow.style.width = `${width}px`;
				noteWindow.style.height = `${height}px`;
			};

			const stop = () => {
				document.removeEventListener('pointermove', resize);
				document.removeEventListener('pointerup', stop);
			};

			document.addEventListener('pointermove', resize);
			document.addEventListener('pointerup', stop);
		});
	});

	openState?.addEventListener('change', () => {
		if (!noteWindow || !openState.checked) return;
		noteWindow.classList.remove('is-resized');
		['left', 'top', 'width', 'height'].forEach((property) => noteWindow.style.removeProperty(property));
	});
</script>

<style>
	:root {
		--ink: #1d1d1f;
		--muted: rgba(60, 60, 67, 0.68);
		--rule: rgba(60, 60, 67, 0.24);
		--sidebar: #e7e7ed;
		--paper: #fff;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	.desktop {
		position: relative;
		min-height: 100svh;
		overflow: hidden;
		font-family: var(--sans);
		color: var(--ink);
		background: var(--paper);
	}

	.window-state {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.notes-window {
		position: relative;
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 1fr);
		min-height: 100svh;
		background: var(--paper);
	}

	.sidebar {
		box-sizing: border-box;
		min-height: 100%;
		padding: 1.25rem 0.875rem;
		background: linear-gradient(180deg, #ededf2 0%, var(--sidebar) 100%);
		border-right: 1px solid var(--rule);
	}

	.sidebar-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.125rem 0.375rem 1.75rem;
	}

	.section-label,
	.selected-note p,
	.selected-note span,
	.date,
	.intro,
	.note-copy,
	.wallpaper-credit {
		margin: 0;
	}

	.sidebar-heading > span {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	.window-controls {
		display: flex;
		gap: 0.4375rem;
	}

	.window-dot {
		position: relative;
		display: block;
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		cursor: pointer;
	}

	.window-dot::after {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.625rem;
		font-weight: 700;
		line-height: 1;
		color: rgba(55, 42, 25, 0.78);
		opacity: 0;
	}

	.window-controls:hover .window-dot::after,
	.window-dot:focus-visible::after {
		opacity: 1;
	}

	.red { background: #ff5f57; }
	.yellow { background: #febc2e; }
	.red::after { content: '×'; }
	.yellow::after { content: '−'; }
	.maximize { display: none; }

	.section-label {
		padding: 0 0.375rem 0.5rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.selected-note {
		padding: 0.625rem 0.75rem;
		border-radius: 0.45rem;
		background: #d1d1d8;
	}

	.selected-note p {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.014em;
	}

	.selected-note span {
		display: block;
		margin-top: 0.125rem;
		font-size: 0.75rem;
		line-height: 1.25;
		color: var(--muted);
	}

	.note-page {
		box-sizing: border-box;
		width: min(100%, 46rem);
		padding: clamp(4.25rem, 13vh, 8.5rem) clamp(1.75rem, 7vw, 6.5rem);
	}

	.date {
		font-size: 0.75rem;
		letter-spacing: -0.006em;
		color: var(--muted);
	}

	h1 {
		margin: 0.875rem 0 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.intro,
	.note-copy {
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.intro { margin-top: 2.25rem; }
	.note-copy { margin-top: 0.5rem; }

	.notes-bay,
	.wallpaper-credit { display: none; }

	.desktop:has(#note-resting:checked),
	.desktop:has(#note-closed:checked) {
		background:
			linear-gradient(rgba(16, 20, 15, 0.08), rgba(16, 20, 15, 0.08)),
			url('/images/tokumeien-zen-garden.jpg') center / cover no-repeat;
	}

	#note-resting:checked ~ .notes-window,
	#note-closed:checked ~ .notes-window {
		position: absolute;
		z-index: 1;
		min-height: 0;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.36);
		border-radius: 0.95rem;
		box-shadow: 0 1.75rem 4.75rem rgba(16, 18, 13, 0.35), 0 0.125rem 0.5rem rgba(16, 18, 13, 0.2);
	}

	#note-resting:checked ~ .notes-window {
		top: clamp(2.5rem, 8vh, 6rem);
		left: 50%;
		width: min(76vw, 68rem);
		height: min(72svh, 46rem);
		min-width: 26.25rem;
		min-height: 18.75rem;
		resize: both;
		transform: translateX(-50%);
	}

	#note-resting:checked ~ .notes-window .maximize { display: block; }
	#note-resting:checked ~ .notes-window .minimize { display: none; }
	#note-resting:checked ~ .notes-window .note-page { padding-top: clamp(3rem, 9vh, 5.75rem); }
	#note-closed:checked ~ .notes-window { display: none; }

	.notes-window.is-resized {
		transform: none !important;
	}

	.resize-handle {
		display: none;
		position: absolute;
		z-index: 4;
		width: 1rem;
		height: 1rem;
		touch-action: none;
	}

	#note-resting:checked ~ .notes-window .resize-handle { display: block; }
	.north-west { top: -0.375rem; left: -0.375rem; cursor: nwse-resize; }
	.north-east { top: -0.375rem; right: -0.375rem; cursor: nesw-resize; }
	.south-west { bottom: -0.375rem; left: -0.375rem; cursor: nesw-resize; }
	.south-east { right: -0.375rem; bottom: -0.375rem; cursor: nwse-resize; }

	#note-resting:checked ~ .notes-bay,
	#note-closed:checked ~ .notes-bay {
		display: flex;
		align-items: flex-end;
		gap: 0.45rem;
		position: fixed;
		z-index: 2;
		bottom: 1.25rem;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.5rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 1rem;
		background: rgba(247, 247, 249, 0.5);
		box-shadow: 0 0.625rem 1.75rem rgba(0, 0, 0, 0.25);
		backdrop-filter: blur(18px) saturate(1.2);
	}

	.dock-app {
		display: grid;
		place-items: center;
		position: relative;
		width: 3rem;
		height: 3rem;
		border-radius: 0.65rem;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08), 0 0.1875rem 0.375rem rgba(0, 0, 0, 0.14);
		transition: transform 160ms ease;
	}

	.dock-app:hover,
	.dock-app:focus-visible {
		transform: translateY(-0.5rem) scale(1.12);
	}

	.notes-app {
		cursor: pointer;
		background: linear-gradient(180deg, #fff 0 17%, #f8dd69 17% 28%, #fff 28%);
	}

	.finder { background: linear-gradient(90deg, #9bd3ff 0 49%, #e9f5ff 49%); }
	.launch { background: linear-gradient(135deg, #e94b43, #ff9d45); }
	.photos { background: conic-gradient(#ee665e, #f6c75b, #74bf79, #61aed8, #b585dc, #ee665e); }
	.music { background: linear-gradient(135deg, #ff6f77, #e5325f); }
	.settings { background: radial-gradient(circle, #c5c8cd 0 28%, #757b84 29% 40%, #d8dade 41% 60%, #737981 61%); }

	.dock-separator {
		width: 1px;
		height: 2.4rem;
		margin: 0 0.075rem;
		background: rgba(0, 0, 0, 0.16);
	}

	.notes-icon {
		display: block;
		width: 1.75rem;
		height: 1.2rem;
		border-radius: 0.15rem;
		background: repeating-linear-gradient(to bottom, transparent 0 0.22rem, rgba(181, 181, 181, 0.72) 0.24rem 0.27rem);
	}

	#note-resting:checked ~ .wallpaper-credit,
	#note-closed:checked ~ .wallpaper-credit {
		display: block;
		position: fixed;
		z-index: 2;
		right: 1rem;
		bottom: 1rem;
		font-size: 0.625rem;
		color: rgba(255, 255, 255, 0.7);
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.48);
	}

	.wallpaper-credit a { color: inherit; }

	@media (max-width: 700px) {
		.notes-window { grid-template-columns: 1fr; }
		.sidebar {
			min-height: auto;
			padding: 1rem 1.125rem;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
		}
		.sidebar-heading { padding: 0; }
		.section-label,
		.selected-note { display: none; }
		.note-page { padding: 3.25rem 1.375rem; }
		#note-resting:checked ~ .notes-window {
			top: 2rem;
			width: calc(100vw - 2rem);
			height: min(70svh, 38rem);
		}
	}
</style>
