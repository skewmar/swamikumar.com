---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="desktop">
		<input class="window-state" type="radio" name="window-state" id="note-resting" checked />
		<input class="window-state" type="radio" name="window-state" id="note-closed" />

		<section class="notes-window" aria-label="Swami Kumar’s note">
			<header class="window-titlebar" data-drag-region>
				<div class="window-controls" aria-label="Window controls" data-window-control>
					<label class="window-dot red" for="note-closed" aria-label="Close note" title="Close note"></label>
				</div>
			</header>

			<aside class="sidebar" aria-label="Notes">
				<div class="sidebar-header">
					<p class="section-label">notes</p>
					<div class="notes-menu-wrap">
						<button class="more-button" type="button" aria-label="Note view options" aria-expanded="false" aria-controls="notes-menu">•••</button>
						<div class="notes-menu" id="notes-menu" role="menu" hidden>
							<button type="button" data-menu-action="gallery">View as Gallery</button>
							<button type="button" data-menu-submenu="sort">Sort By <span>›</span></button>
							<button type="button" data-menu-submenu="group">Group By <span>›</span></button>
							<div class="menu-submenu" data-submenu="sort" hidden>
								<button type="button" data-menu-value="date-edited">Date Edited</button>
								<button type="button" data-menu-value="date-created">Date Created</button>
								<button type="button" data-menu-value="title">Title</button>
							</div>
							<div class="menu-submenu" data-submenu="group" hidden>
								<button type="button" data-menu-value="date">Date</button>
								<button type="button" data-menu-value="none">None</button>
							</div>
						</div>
					</div>
				</div>
				<div class="selected-note">
					<p><span class="note-emoji" aria-hidden="true">📌</span>A creative mind</p>
					<span>in a logical world</span>
				</div>
			</aside>

			<article class="note-page">
				<p class="date">August 2026</p>
				<h1>swami kumar</h1>
				<p class="intro">A creative mind stuck in a logical world.</p>
				<p class="note-copy">Notes on crafting, systems, and in-between spaces.</p>
			</article>
			<section class="gallery-preview" aria-label="Gallery preview">
				<button class="gallery-card" type="button" aria-label="Open the swami kumar note">
					<img class="note-cover" src="/images/tokumeien-zen-garden.jpg" alt="Autumn garden with red and green trees" width="1200" height="800" loading="lazy" decoding="async" />
					<div class="gallery-card-content">
						<p>August 2026</p>
						<h2><span aria-hidden="true">📌</span> swami kumar</h2>
						<span>A creative mind stuck in a logical world.</span>
					</div>
				</button>
			</section>
			<span class="sidebar-resize" aria-hidden="true"></span>
			<span class="resize-handle north-west" aria-hidden="true"></span>
			<span class="resize-handle north-east" aria-hidden="true"></span>
			<span class="resize-handle south-west" aria-hidden="true"></span>
			<span class="resize-handle south-east" aria-hidden="true"></span>
		</section>

		<div class="notes-bay" aria-label="Notes dock">
			<label class="dock-app notes-app" for="note-resting" aria-label="Open note" title="Open note">
				<span class="dock-tooltip" role="tooltip">Notes</span>
				<img class="notes-icon" src="/images/notes-dock-icon.png" alt="" aria-hidden="true" width="512" height="512" />
			</label>
		</div>

		<p class="wallpaper-credit">
			Photo by <a href="https://unsplash.com/@dreiimos">Lucas Calloch</a> on <a href="https://unsplash.com/photos/red-and-green-trees-beside-river-during-daytime-P-yzuyWFEIk">Unsplash</a>
		</p>
	</main>
</Layout>

<script>
	const noteWindow = document.querySelector('.notes-window');
	const restingState = document.querySelector('#note-resting');
	const resizeHandles = document.querySelectorAll('.resize-handle');
	const titlebar = document.querySelector('[data-drag-region]');
	const sidebar = document.querySelector('.sidebar');
	const sidebarResize = document.querySelector('.sidebar-resize');
	const moreButton = document.querySelector('.more-button');
	const notesMenu = document.querySelector('.notes-menu');
	const menuWrap = document.querySelector('.notes-menu-wrap');
	const galleryCard = document.querySelector('.gallery-card');

	const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

	resizeHandles.forEach((handle) => {
		handle.addEventListener('pointerdown', (event) => {
			if (!noteWindow || !restingState?.checked) return;

			event.preventDefault();
			const edge = [...handle.classList].find((name) => ['north-west', 'north-east', 'south-west', 'south-east'].includes(name));
			const startingRect = noteWindow.getBoundingClientRect();
			const startX = event.clientX;
			const startY = event.clientY;
			const minWidth = 420;
			const minHeight = 300;

			noteWindow.classList.add('is-resized');
			noteWindow.style.left = `${startingRect.left}px`;
			noteWindow.style.top = `${startingRect.top}px`;
			noteWindow.style.width = `${startingRect.width}px`;
			noteWindow.style.height = `${startingRect.height}px`;

			const resize = (moveEvent) => {
				const shiftX = moveEvent.clientX - startX;
				const shiftY = moveEvent.clientY - startY;
				let width = startingRect.width;
				let height = startingRect.height;
				let left = startingRect.left;
				let top = startingRect.top;

				if (edge?.includes('east')) width = clamp(startingRect.width + shiftX, minWidth, window.innerWidth - startingRect.left);
				if (edge?.includes('south')) height = clamp(startingRect.height + shiftY, minHeight, window.innerHeight - startingRect.top);
				if (edge?.includes('west')) {
					left = clamp(startingRect.left + shiftX, 0, startingRect.right - minWidth);
					width = startingRect.right - left;
				}
				if (edge?.includes('north')) {
					top = clamp(startingRect.top + shiftY, 0, startingRect.bottom - minHeight);
					height = startingRect.bottom - top;
				}

				noteWindow.style.left = `${left}px`;
				noteWindow.style.top = `${top}px`;
				noteWindow.style.width = `${width}px`;
				noteWindow.style.height = `${height}px`;
			};

			const stop = () => {
				document.removeEventListener('pointermove', resize);
				document.removeEventListener('pointerup', stop);
			};

			document.addEventListener('pointermove', resize);
			document.addEventListener('pointerup', stop);
		});
	});

	titlebar?.addEventListener('pointerdown', (event) => {
		if (!noteWindow || !restingState?.checked || event.target.closest('[data-window-control]')) return;

		event.preventDefault();
		const startingRect = noteWindow.getBoundingClientRect();
		const startX = event.clientX;
		const startY = event.clientY;

		noteWindow.classList.add('is-manually-positioned');
		noteWindow.style.left = `${startingRect.left}px`;
		noteWindow.style.top = `${startingRect.top}px`;

		const move = (moveEvent) => {
			const left = clamp(startingRect.left + moveEvent.clientX - startX, 0, window.innerWidth - startingRect.width);
			const top = clamp(startingRect.top + moveEvent.clientY - startY, 0, window.innerHeight - startingRect.height);
			noteWindow.style.left = `${left}px`;
			noteWindow.style.top = `${top}px`;
		};

		const stop = () => {
			document.removeEventListener('pointermove', move);
			document.removeEventListener('pointerup', stop);
		};

		document.addEventListener('pointermove', move);
		document.addEventListener('pointerup', stop);
	});

	sidebarResize?.addEventListener('pointerdown', (event) => {
		if (!sidebar || !noteWindow) return;
		event.preventDefault();
		const startingWidth = sidebar.getBoundingClientRect().width;
		const startX = event.clientX;

		const resizeSidebar = (moveEvent) => {
			const maxWidth = Math.min(30 * 16, noteWindow.getBoundingClientRect().width - 22 * 16);
			const width = clamp(startingWidth + moveEvent.clientX - startX, 11.5 * 16, maxWidth);
			noteWindow.style.setProperty('--sidebar-width', `${width}px`);
		};

		const stop = () => {
			document.removeEventListener('pointermove', resizeSidebar);
			document.removeEventListener('pointerup', stop);
		};

		document.addEventListener('pointermove', resizeSidebar);
		document.addEventListener('pointerup', stop);
	});

	const closeMenu = () => {
		if (!notesMenu || !moreButton) return;
		notesMenu.hidden = true;
		moreButton.setAttribute('aria-expanded', 'false');
		notesMenu.querySelectorAll('.menu-submenu').forEach((submenu) => { submenu.hidden = true; });
	};

	moreButton?.addEventListener('click', () => {
		if (!notesMenu || !moreButton) return;
		const willOpen = notesMenu.hidden;
		closeMenu();
		notesMenu.hidden = !willOpen;
		moreButton.setAttribute('aria-expanded', String(willOpen));
	});

	const setGalleryView = (active) => {
		if (!noteWindow) return;
		noteWindow.classList.toggle('gallery-active', active);
		const galleryAction = notesMenu?.querySelector('[data-menu-action="gallery"]');
		if (galleryAction) galleryAction.textContent = active ? 'View as List' : 'View as Gallery';
	};

	notesMenu?.querySelector('[data-menu-action="gallery"]')?.addEventListener('click', () => {
		if (!noteWindow) return;
		setGalleryView(!noteWindow.classList.contains('gallery-active'));
		closeMenu();
	});

	galleryCard?.addEventListener('click', () => setGalleryView(false));

	notesMenu?.querySelectorAll('[data-menu-submenu]').forEach((button) => {
		button.addEventListener('click', () => {
			const target = notesMenu.querySelector(`[data-submenu="${button.dataset.menuSubmenu}"]`);
			notesMenu.querySelectorAll('.menu-submenu').forEach((submenu) => { submenu.hidden = submenu !== target; });
		});
	});

	notesMenu?.querySelectorAll('[data-menu-value]').forEach((button) => {
		button.addEventListener('click', () => {
			if (!noteWindow) return;
			const container = button.closest('.menu-submenu');
			noteWindow.dataset[container?.dataset.submenu || 'view'] = button.dataset.menuValue || '';
			closeMenu();
		});
	});

	document.addEventListener('pointerdown', (event) => {
		if (notesMenu && !notesMenu.hidden && !menuWrap?.contains(event.target)) closeMenu();
	});

</script>

<style>
	:root {
		--ink: #1d1d1f;
		--muted: rgba(60, 60, 67, 0.68);
		--rule: rgba(60, 60, 67, 0.24);
		--sidebar: #e7e7ed;
		--paper: #fff;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	.desktop {
		position: relative;
		min-height: 100svh;
		overflow: hidden;
		font-family: var(--sans);
		color: var(--ink);
		background: var(--paper);
	}

	.window-state {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.notes-window {
		position: relative;
		display: grid;
		grid-template-columns: var(--sidebar-width, 17.5rem) minmax(0, 1fr);
		grid-template-rows: 2.75rem minmax(0, 1fr);
		min-height: 100svh;
		background: var(--paper);
	}

	.window-titlebar {
		grid-column: 1 / -1;
		grid-row: 1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 0.875rem;
		background: linear-gradient(180deg, rgba(250, 250, 251, 0.96), rgba(238, 238, 240, 0.94));
		border-bottom: 1px solid var(--rule);
		backdrop-filter: blur(22px) saturate(1.25);
		cursor: grab;
		touch-action: none;
	}

	.window-titlebar:active { cursor: grabbing; }

	.sidebar {
		grid-column: 1;
		grid-row: 2;
		box-sizing: border-box;
		min-height: 100%;
		min-width: 0;
		padding: 1.125rem 0.875rem;
		background: linear-gradient(180deg, #ededf2 0%, var(--sidebar) 100%);
		border-right: 1px solid var(--rule);
	}

	.section-label,
	.selected-note p,
	.selected-note span,
	.date,
	.intro,
	.note-copy,
	.wallpaper-credit {
		margin: 0;
	}

	.window-controls {
		display: flex;
		gap: 0.4375rem;
	}

	.window-dot {
		position: relative;
		display: block;
		width: 0.75rem;
		height: 0.75rem;
		padding: 0;
		border-radius: 50%;
		border: 0;
		cursor: pointer;
	}

	.window-dot::after {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.625rem;
		font-weight: 700;
		line-height: 1;
		color: rgba(55, 42, 25, 0.78);
		opacity: 0;
	}

	.window-controls:hover .window-dot::after,
	.window-dot:focus-visible::after {
		opacity: 1;
	}

	.red { background: #ff5f57; }
	.red::after { content: '×'; }

	.sidebar-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.35rem;
		padding: 0 0.375rem 0.5rem;
	}

	.notes-menu-wrap { position: relative; flex: none; }

	.more-button {
		border: 0;
		padding: 0.25rem 0.35rem;
		border-radius: 0.35rem;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.8125rem;
		letter-spacing: 0.08em;
		cursor: pointer;
	}

	.more-button:hover,
	.more-button[aria-expanded='true'] { background: rgba(60, 60, 67, 0.09); }

	.notes-menu {
		position: absolute;
		z-index: 8;
		top: calc(100% + 0.45rem);
		right: 0;
		width: 12.5rem;
		padding: 0.3rem;
		border: 1px solid rgba(60, 60, 67, 0.17);
		border-radius: 0.55rem;
		background: rgba(252, 252, 253, 0.96);
		box-shadow: 0 0.6rem 1.5rem rgba(0, 0, 0, 0.15);
		backdrop-filter: blur(18px);
	}

	.notes-menu button {
		display: flex;
		justify-content: space-between;
		width: 100%;
		padding: 0.45rem 0.55rem;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
		font: inherit;
		font-size: 0.75rem;
		text-align: left;
		cursor: pointer;
	}

	.notes-menu button:hover { background: #ffe595; }

	.menu-submenu {
		position: absolute;
		top: 2.4rem;
		left: calc(100% + 0.3rem);
		width: 10.5rem;
		padding: 0.3rem;
		border: 1px solid rgba(60, 60, 67, 0.17);
		border-radius: 0.55rem;
		background: rgba(252, 252, 253, 0.97);
		box-shadow: 0 0.6rem 1.5rem rgba(0, 0, 0, 0.15);
	}

	.section-label {
		padding: 0;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.selected-note {
		padding: 0.625rem 0.75rem;
		border-radius: 0.45rem;
		background: #d1d1d8;
	}

	.selected-note p {
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.014em;
	}

	.note-emoji { margin-right: 0.25rem; }

	.selected-note span {
		display: block;
		margin-top: 0.125rem;
		overflow: hidden;
		white-space: nowrap;
		text-overflow: ellipsis;
		font-size: 0.75rem;
		line-height: 1.25;
		color: var(--muted);
	}

	.note-page {
		grid-column: 2;
		grid-row: 2;
		box-sizing: border-box;
		width: min(100%, 46rem);
		padding: clamp(3.25rem, 9vh, 6.5rem) clamp(1.5rem, 3vw, 3.75rem);
	}

	.date {
		font-size: 0.75rem;
		letter-spacing: -0.006em;
		color: var(--muted);
	}

	h1 {
		margin: 0.875rem 0 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.intro,
	.note-copy {
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.intro { margin-top: 2.25rem; }
	.note-copy { margin-top: 0.5rem; }

	.note-page a {
		border-radius: 0.2rem;
		color: #7a4b00;
		background: linear-gradient(180deg, transparent 45%, rgba(255, 213, 89, 0.74) 45%);
		text-decoration: none;
		text-underline-offset: 0.14em;
	}

	.note-page a:hover,
	.note-page a:focus-visible {
		background: #ffe28a;
		outline: 0;
		text-decoration: underline;
	}

	.gallery-preview {
		display: none;
		grid-column: 2;
		grid-row: 2;
		align-content: start;
		grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
		gap: 1rem;
		padding: clamp(2rem, 6vh, 4rem) clamp(1.5rem, 3vw, 3.75rem);
	}

	.gallery-card {
		box-sizing: border-box;
		width: 100%;
		padding: 0;
		overflow: hidden;
		border: 1px solid rgba(60, 60, 67, 0.14);
		border-radius: 0.65rem;
		background: linear-gradient(145deg, #fff, #f2f2f6);
		color: var(--ink);
		font: inherit;
		text-align: left;
		box-shadow: 0 0.25rem 0.75rem rgba(0, 0, 0, 0.05);
		cursor: pointer;
	}

	.note-cover {
		display: block;
		width: 100%;
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	.gallery-card-content { padding: 1rem; }

	.gallery-card:hover,
	.gallery-card:focus-visible {
		border-color: rgba(60, 60, 67, 0.28);
		box-shadow: 0 0.4rem 1rem rgba(0, 0, 0, 0.09);
	}

	.gallery-card p,
	.gallery-card span { margin: 0; font-size: 0.75rem; color: var(--muted); }
	.gallery-card h2 { margin: 1.5rem 0 0.45rem; font-size: 1rem; font-weight: 600; }
	.notes-window.gallery-active .note-page { display: none; }
	.notes-window.gallery-active .gallery-preview { display: grid; }

	.sidebar-resize {
		position: absolute;
		z-index: 5;
		top: 2.75rem;
		bottom: 0;
		left: calc(var(--sidebar-width, 17.5rem) - 0.25rem);
		width: 0.5rem;
		cursor: col-resize;
		touch-action: none;
	}

	.sidebar-resize::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0.125rem;
		width: 0.125rem;
		height: 2rem;
		border-radius: 1rem;
		background: rgba(60, 60, 67, 0.22);
		opacity: 0;
		transform: translateY(-50%);
	}

	.notes-window:hover .sidebar-resize::after,
	.sidebar-resize:hover::after { opacity: 1; }

	.notes-bay,
	.wallpaper-credit { display: none; }

	.desktop:has(#note-resting:checked),
	.desktop:has(#note-closed:checked) {
		background: url('/images/tokumeien-zen-garden.jpg') center / cover no-repeat;
	}

	#note-resting:checked ~ .notes-window,
	#note-closed:checked ~ .notes-window {
		position: absolute;
		z-index: 1;
		min-height: 0;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.48);
		border-radius: 0.95rem;
		box-shadow: 0 1.75rem 4.75rem rgba(16, 18, 13, 0.3), 0 0.125rem 0.5rem rgba(16, 18, 13, 0.18);
	}

	#note-resting:checked ~ .notes-window {
		top: clamp(3.25rem, 10vh, 7rem);
		left: 50%;
		width: min(66vw, 60rem);
		height: min(62svh, 40rem);
		min-width: 26.25rem;
		min-height: 18.75rem;
		resize: both;
		transform: translateX(-50%);
	}

	#note-resting:checked ~ .notes-window .note-page { padding-top: clamp(3rem, 9vh, 5.75rem); }
	#note-closed:checked ~ .notes-window { display: none; }

	.notes-window.is-resized,
	.notes-window.is-manually-positioned {
		transform: none !important;
	}

	.resize-handle {
		display: none;
		position: absolute;
		z-index: 4;
		width: 1rem;
		height: 1rem;
		touch-action: none;
	}

	#note-resting:checked ~ .notes-window .resize-handle { display: block; }
	.north-west { top: -0.375rem; left: -0.375rem; cursor: nwse-resize; }
	.north-east { top: -0.375rem; right: -0.375rem; cursor: nesw-resize; }
	.south-west { bottom: -0.375rem; left: -0.375rem; cursor: nesw-resize; }
	.south-east { right: -0.375rem; bottom: -0.375rem; cursor: nwse-resize; }

	#note-resting:checked ~ .notes-bay,
	#note-closed:checked ~ .notes-bay {
		display: flex;
		align-items: flex-end;
		gap: 0.45rem;
		position: fixed;
		z-index: 2;
		bottom: 0.75rem;
		left: 50%;
		transform: translateX(-50%);
		padding: 0.5rem 0.75rem 0.72rem;
		border: 1px solid rgba(255, 255, 255, 0.42);
		border-radius: 1.15rem;
		background: rgba(255, 255, 255, 0.32);
		box-shadow: 0 0.75rem 2rem rgba(0, 0, 0, 0.26);
		backdrop-filter: blur(32px) saturate(1.5);
	}

	.dock-app {
		display: grid;
		place-items: center;
		position: relative;
		width: 4rem;
		height: 4rem;
		transition: transform 100ms ease-out;
		transform-origin: bottom center;
	}

	.dock-app:hover,
	.dock-app:focus-visible {
		transform: translateY(-0.5rem) scale(1.22);
	}

	.notes-app {
		cursor: pointer;
	}

	.dock-tooltip {
		position: absolute;
		top: -2.65rem;
		left: 50%;
		z-index: 1;
		padding: 0.35rem 0.6rem;
		border: 1px solid rgba(255, 255, 255, 0.56);
		border-radius: 0.45rem;
		background: rgba(255, 255, 255, 0.78);
		box-shadow: 0 0.2rem 0.65rem rgba(0, 0, 0, 0.16);
		color: #29292d;
		font-size: 0.6875rem;
		font-weight: 600;
		opacity: 0;
		pointer-events: none;
		transform: translateX(-50%) translateY(0.25rem);
		transition: opacity 100ms ease-out, transform 100ms ease-out;
		white-space: nowrap;
	}

	.dock-tooltip::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		width: 0.45rem;
		height: 0.45rem;
		background: rgba(255, 255, 255, 0.78);
