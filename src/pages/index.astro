---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="notes">
		<input class="view-input" type="radio" name="view" id="note-view" checked />
		<input class="view-input" type="radio" name="view" id="things-view" />
		<aside class="sidebar" aria-label="Notes">
			<div class="sidebar-heading">
				<p>swami kumar</p>
				<span aria-hidden="true">•••</span>
			</div>
			<p class="section-label">notes</p>
			<div class="selected-note">
				<p>A creative mind</p>
				<span>in a logical world</span>
			</div>
		</aside>

		<section class="workspace">
			<nav class="view-toggle" aria-label="View">
				<label for="note-view">note</label>
				<label for="things-view">things</label>
			</nav>

			<article class="note-page">
				<p class="date">August 2026</p>
				<h1>swami kumar</h1>
				<p class="intro">A creative mind stuck in a logical world.</p>
				<p class="note-copy">Notes on crafting, systems, and in-between spaces.</p>
			</article>

			<section class="things-page" aria-label="Things">
				<p class="date">A small visual shelf</p>
				<h2>things</h2>
				<div class="visual-grid">
					<figure class="visual-card cool">
						<img src="/images/abstract-cool-lines.png" alt="Cool abstract watercolor with fine lines" />
						<figcaption>cool lines</figcaption>
					</figure>
					<figure class="visual-card warm">
						<img src="/images/abstract-warm-earth.png" alt="Warm abstract watercolor with fine lines" />
						<figcaption>warm earth</figcaption>
					</figure>
					<div class="material-card">
						<span class="material-dot blue"></span>
						<span class="material-dot peach"></span>
						<span class="material-dot graphite"></span>
						<p>images, fragments, and future experiments.</p>
					</div>
				</div>
			</section>
		</section>
	</main>
</Layout>

<style>
	:root {
		--ink: #1d1d1f;
		--muted: rgba(60, 60, 67, 0.68);
		--rule: rgba(60, 60, 67, 0.24);
		--sidebar: #e7e7ed;
		--paper: #fff;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	.notes {
		position: relative;
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 1fr);
		min-height: 100svh;
		font-family: var(--sans);
		color: var(--ink);
		background: var(--paper);
	}

	.sidebar {
		box-sizing: border-box;
		min-height: 100%;
		padding: 1.25rem 0.875rem;
		background: linear-gradient(180deg, #ededf2 0%, var(--sidebar) 100%);
		border-right: 1px solid var(--rule);
	}

	.sidebar-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.125rem 0.375rem 1.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.sidebar-heading p,
	.section-label,
	.selected-note p,
	.selected-note span,
	.date,
	.intro,
	.note-copy {
		margin: 0;
	}

	.sidebar-heading span {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	.section-label {
		padding: 0 0.375rem 0.5rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.selected-note {
		padding: 0.625rem 0.75rem;
		border-radius: 0.45rem;
		background: #d1d1d8;
	}

	.selected-note p {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.014em;
	}

	.selected-note span {
		display: block;
		margin-top: 0.125rem;
		font-size: 0.75rem;
		line-height: 1.25;
		color: var(--muted);
	}

	.view-input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}

	.workspace {
		position: relative;
		min-width: 0;
		background: var(--paper);
	}

	.view-toggle {
		display: inline-flex;
		gap: 0.125rem;
		position: absolute;
		top: 1.25rem;
		right: clamp(1.25rem, 4vw, 4rem);
		padding: 0.1875rem;
		border: 1px solid rgba(60, 60, 67, 0.18);
		border-radius: 0.55rem;
		background: rgba(246, 246, 248, 0.92);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
	}

	.view-toggle label {
		cursor: pointer;
		padding: 0.3125rem 0.625rem;
		border-radius: 0.35rem;
		font-size: 0.75rem;
		font-weight: 500;
		line-height: 1;
		color: var(--muted);
	}

	#note-view:checked ~ .workspace label[for='note-view'],
	#things-view:checked ~ .workspace label[for='things-view'] {
		background: #fff;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
		color: var(--ink);
	}

	.note-page,
	.things-page {
		box-sizing: border-box;
		width: min(100%, 46rem);
		padding: clamp(4.25rem, 13vh, 8.5rem) clamp(1.75rem, 7vw, 6.5rem);
	}

	.things-page {
		display: none;
		width: min(100%, 56rem);
	}

	#things-view:checked ~ .workspace .note-page {
		display: none;
	}

	#things-view:checked ~ .workspace .things-page {
		display: block;
	}

	.date {
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: -0.006em;
		color: var(--muted);
	}

	h1 {
		margin: 0.875rem 0 0;
		font-size: 1.5rem;
		font-weight: 600;
		letter-spacing: normal;
		line-height: 1.25;
	}

	h2 {
		margin: 0.875rem 0 0;
		font-size: 1.5rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.intro {
		margin-top: 2.25rem;
		font-size: 0.875rem;
		font-weight: 400;
		letter-spacing: normal;
		line-height: 1.5;
	}

	.note-copy {
		margin-top: 0.5rem;
		font-size: 0.875rem;
		letter-spacing: normal;
		line-height: 1.5;
		color: var(--ink);
	}

	.visual-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 2.25rem;
	}

	.visual-card,
	.material-card {
		margin: 0;
		min-width: 0;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #f5f5f7;
	}

	.visual-card img {
		display: block;
		width: 100%;
		aspect-ratio: 1.2;
		object-fit: cover;
	}

	.visual-card figcaption {
		padding: 0.625rem 0.75rem 0.75rem;
		font-size: 0.75rem;
		color: var(--muted);
	}

	.material-card {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		grid-column: span 2;
		padding: 1rem;
	}

	.material-dot {
		display: block;
		flex: 0 0 auto;
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 50%;
	}

	.blue { background: #9fc6d8; }
	.peach { background: #dfae8f; }
	.graphite { background: #51545a; }

	.material-card p {
		margin: 0 0 0 0.25rem;
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--muted);
	}

	@media (max-width: 700px) {
		.notes {
			grid-template-columns: 1fr;
		}

		.sidebar {
			min-height: auto;
			padding: 1rem 1.125rem;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
		}

		.sidebar-heading {
			padding: 0;
		}

		.section-label,
		.selected-note {
			display: none;
		}

		.note-page {
			padding: 3.25rem 1.375rem;
		}

		.things-page {
			padding: 3.25rem 1.375rem;
		}

		.view-toggle {
			top: 0.75rem;
			right: 1.125rem;
		}

		.visual-grid {
			grid-template-columns: 1fr;
		}

		.material-card {
			grid-column: auto;
		}
	}
</style>
