---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="home">
		<section class="content">
			<h1>swami kumar</h1>
			<p class="intro">A creative mind stuck in a logical world.</p>
			<p class="note">Notes on crafting, systems, and in-between spaces.</p>
		</section>
	</main>
</Layout>

<style>
	:root {
		--ink: #1d1d1f;
		--muted: rgba(60, 60, 67, 0.72);
		--paper: #f6f4ed;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	.home {
		box-sizing: border-box;
		min-height: 100svh;
		background: #fbfaf8;
	}

	.content {
		max-width: 38rem;
		padding: clamp(4.5rem, 15vh, 9rem) 1.5rem;
		margin-left: clamp(1rem, 8vw, 9rem);
		font-family: var(--sans);
	}

	h1 {
		margin: 0;
		font-size: 1.375rem;
		font-weight: 650;
		letter-spacing: -0.045em;
		line-height: 1.2;
		color: var(--ink);
	}

	.intro {
		margin: 1.625rem 0 0;
		font-size: 1.0625rem;
		line-height: 1.5;
		letter-spacing: -0.018em;
		color: var(--ink);
	}

	.note {
		margin: 0.375rem 0 0;
		font-size: 0.875rem;
		line-height: 1.5;
		letter-spacing: -0.01em;
		color: var(--muted);
	}

	@media (max-width: 600px) {
		.content {
			padding: 3.5rem 1.375rem;
			margin-left: 0;
		}
	}
</style>
