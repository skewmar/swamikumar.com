---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="notes">
		<aside class="sidebar" aria-label="Notes">
			<div class="sidebar-heading">
				<p>swami kumar</p>
				<span aria-hidden="true">•••</span>
			</div>
			<p class="section-label">notes</p>
			<div class="selected-note">
				<p>A creative mind</p>
				<span>in a logical world</span>
			</div>
		</aside>

		<article class="note-page">
			<p class="date">August 2026</p>
			<h1>swami kumar</h1>
			<p class="intro">A creative mind stuck in a logical world.</p>
			<p class="note-copy">Notes on crafting, systems, and in-between spaces.</p>
		</article>
	</main>
</Layout>

<style>
	:root {
		--ink: #1d1d1f;
		--muted: rgba(60, 60, 67, 0.68);
		--rule: rgba(60, 60, 67, 0.16);
		--sidebar: #f2f2f7;
		--paper: #fff;
		--sans: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', sans-serif;
	}

	.notes {
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 1fr);
		min-height: 100svh;
		font-family: var(--sans);
		color: var(--ink);
		background: var(--paper);
	}

	.sidebar {
		box-sizing: border-box;
		min-height: 100%;
		padding: 1.25rem 0.875rem;
		background: var(--sidebar);
		border-right: 1px solid var(--rule);
	}

	.sidebar-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.125rem 0.375rem 1.75rem;
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.015em;
	}

	.sidebar-heading p,
	.section-label,
	.selected-note p,
	.selected-note span,
	.date,
	.intro,
	.note-copy {
		margin: 0;
	}

	.sidebar-heading span {
		color: var(--muted);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	.section-label {
		padding: 0 0.375rem 0.5rem;
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.selected-note {
		padding: 0.625rem 0.75rem;
		border-radius: 0.45rem;
		background: #e3e3e8;
	}

	.selected-note p {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: -0.014em;
	}

	.selected-note span {
		display: block;
		margin-top: 0.125rem;
		font-size: 0.75rem;
		line-height: 1.25;
		color: var(--muted);
	}

	.note-page {
		box-sizing: border-box;
		width: min(100%, 46rem);
		padding: clamp(4.25rem, 13vh, 8.5rem) clamp(1.75rem, 7vw, 6.5rem);
	}

	.date {
		font-size: 0.75rem;
		font-weight: 400;
		letter-spacing: -0.006em;
		color: var(--muted);
	}

	h1 {
		margin: 0.875rem 0 0;
		font-size: clamp(1.75rem, 3vw, 2.125rem);
		font-weight: 700;
		letter-spacing: -0.052em;
		line-height: 1.1;
	}

	.intro {
		margin-top: 2.25rem;
		font-size: 1.0625rem;
		font-weight: 400;
		letter-spacing: -0.018em;
		line-height: 1.52;
	}

	.note-copy {
		margin-top: 0.5rem;
		font-size: 1.0625rem;
		letter-spacing: -0.018em;
		line-height: 1.52;
		color: var(--muted);
	}

	@media (max-width: 700px) {
		.notes {
			grid-template-columns: 1fr;
		}

		.sidebar {
			min-height: auto;
			padding: 1rem 1.125rem;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
		}

		.sidebar-heading {
			padding: 0;
		}

		.section-label,
		.selected-note {
			display: none;
		}

		.note-page {
			padding: 3.25rem 1.375rem;
		}
	}
</style>
