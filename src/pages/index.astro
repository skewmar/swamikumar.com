---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="placeholder">
		<div class="wash wash-sky" aria-hidden="true"></div>
		<div class="wash wash-sea" aria-hidden="true"></div>
		<div class="paper-grain" aria-hidden="true"></div>

		<section class="intro">
			<p class="kicker">swamikumar.com</p>
			<h1>Swami Kumar</h1>
			<p class="status">Coming soon</p>
		</section>
	</main>
</Layout>

<style>
	:root {
		--ink: #232421;
		--quiet-ink: rgba(35, 36, 33, 0.57);
	}

	.placeholder {
		position: relative;
		display: grid;
		min-height: 100vh;
		place-items: center;
		overflow: hidden;
		isolation: isolate;
		background: linear-gradient(146deg, #f9f7f0 3%, #eaf1ee 44%, #e2edf0 100%);
	}

	.wash {
		position: absolute;
		z-index: -2;
		border-radius: 45% 55% 58% 42% / 52% 43% 57% 48%;
		filter: blur(44px) saturate(82%);
		opacity: 0.78;
		transform: rotate(-8deg);
	}

	.wash-sky {
		top: -23vmax;
		right: -13vmax;
		width: 72vmax;
		height: 60vmax;
		background:
			radial-gradient(ellipse at 32% 61%, rgba(184, 214, 222, 0.78), transparent 51%),
			radial-gradient(ellipse at 65% 38%, rgba(226, 235, 221, 0.88), transparent 60%);
	}

	.wash-sea {
		bottom: -28vmax;
		left: -20vmax;
		width: 76vmax;
		height: 51vmax;
		background:
			radial-gradient(ellipse at 57% 35%, rgba(154, 196, 201, 0.45), transparent 55%),
			radial-gradient(ellipse at 28% 61%, rgba(239, 229, 200, 0.64), transparent 62%);
	}

	.paper-grain {
		position: absolute;
		inset: 0;
		z-index: -1;
		opacity: 0.55;
		background-image:
			radial-gradient(rgba(42, 57, 50, 0.15) 0.55px, transparent 0.8px),
			radial-gradient(rgba(255, 255, 255, 0.95) 0.55px, transparent 0.85px),
			repeating-linear-gradient(103deg, transparent 0 8px, rgba(73, 98, 88, 0.045) 9px, transparent 10px);
		background-position: 0 0, 4px 5px, 0 0;
		background-size: 7px 7px, 11px 11px, 19px 23px;
		mix-blend-mode: multiply;
		pointer-events: none;
	}

	.intro {
		padding: 2rem;
		text-align: center;
		animation: appear 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.kicker,
	.status {
		margin: 0;
		font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
		font-size: 0.73rem;
		font-weight: 500;
		letter-spacing: 0.11em;
		text-transform: uppercase;
		color: var(--quiet-ink);
	}

	h1 {
		margin: 1rem 0 1.35rem;
		font-family: 'Iowan Old Style', Iowan, Baskerville, 'Times New Roman', serif;
		font-size: clamp(3.4rem, 10vw, 7.75rem);
		font-weight: 400;
		letter-spacing: -0.07em;
		line-height: 0.93;
		color: var(--ink);
	}

	.status {
		letter-spacing: 0.04em;
		text-transform: none;
	}

	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(10px);
		}

		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.intro {
			animation: none;
		}
	}
</style>
